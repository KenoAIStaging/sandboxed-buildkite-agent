#!/bin/bash
# Deploy Julia CI onto an INTEL mac, from Recovery.
#
#   1. Boot holding Cmd-R (prefer Option-Cmd-R: newest recoveryOS, whose
#      environment is least likely to reject a newer installer)
#   2. Utilities > Terminal:
#        hdiutil mount http://<server>/juliaci.dmg
#        /Volumes/JULIACI/run
#
# ERASES the target volume and installs macOS + firstboot.pkg.
# Usage: run [-y] [target-volume-name]   (default target: "Macintosh HD")
set -euo pipefail

VOL="$(cd "$(dirname "$0")" && pwd)"
ASSUME_YES=""
[ "${1:-}" = "-y" ] && { ASSUME_YES=1; shift; }
TARGET="${1:-Macintosh HD}"

INSTALLERS=("$VOL"/Install\ macOS*.app)
INSTALLER="${INSTALLERS[0]}"
[ -d "$INSTALLER" ] || { echo "error: no installer app on $VOL"; exit 1; }
[ -e "/Volumes/$TARGET" ] || {
    echo "error: /Volumes/$TARGET not found. If the disk is blank or from an"
    echo "older install, erase it as APFS named 'Macintosh HD' in Disk Utility"
    echo "first, or pass the volume name: run [-y] <name>"
    exit 1
}

echo "About to ERASE '/Volumes/$TARGET' and install:"
echo "    $(basename "$INSTALLER") + firstboot.pkg"
if [ -z "$ASSUME_YES" ]; then
    printf "Type yes to continue: "
    read -r ANSWER
    [ "$ANSWER" = "yes" ] || exit 1
fi

# Flags mirror what MDS uses (see its firstboot.sh); the machine reboots into
# the installer and firstboot.pkg is applied on first boot of the new system.
"$INSTALLER/Contents/Resources/startosinstall" \
    --agreetolicense --nointeraction --forcequitapps \
    --eraseinstall --newvolumename "Macintosh HD" \
    --volume "/Volumes/$TARGET" \
    --installpackage "$VOL/firstboot.pkg"
